# .gitattributes — normalización de fin de línea
#
# Por qué: los repos SYC en Windows suelen tener core.autocrlf=true, que
# convierte LF↔CRLF en cada checkout. Eso (a) llena los `git add` de
# warnings "LF will be replaced by CRLF", y (b) hace que el hash del
# working-tree de un archivo difiera del blob, rompiendo la detección de
# cambios de `.ai-dlc-version` en `/adopt --upgrade`.
#
# Con `eol=lf` el working tree queda en LF en todas las plataformas:
# sin warnings, y sha256(working-tree) == sha256(blob) → hashing estable.

# Texto: normalizar a LF en repo y working tree.
* text=auto eol=lf

# Scripts específicos de Windows: mantener CRLF (los espera cmd.exe).
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binarios: nunca tocar.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
